# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# Public Supabase URL (required)
# Format: https://<project-ref>.supabase.co (no trailing slash)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key (optional - only needed for client-side auth)
# This is safe to expose in client-side code
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (required - KEEP SECRET!)
# This key bypasses Row Level Security and should ONLY be used server-side
# Never expose this in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Clinic ID (optional - used as default clinic identifier)
NEXT_PUBLIC_CLINIC_ID=your-clinic-id-here

# Cron job authentication secret (optional)
# Set this to secure the /api/cron/send-reminders endpoint.
# The Vercel Cron job must send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-cron-secret-here

# Basic Auth（従来方式、NEXT_PUBLIC_SUPABASE_URL 未設定時に使用）
DASHBOARD_BASIC_AUTH_USER=admin
DASHBOARD_BASIC_AUTH_PASSWORD=password

# === メール送信（いずれか1つ設定） ===
EMAIL_PROVIDER=smtp  # smtp | sendgrid | resend
EMAIL_FROM=noreply@your-clinic.com
# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# SendGrid
SENDGRID_API_KEY=SG.xxxxx
# Resend
RESEND_API_KEY=re_xxxxx

# SMS送信
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+81xxxxx

# LINE通知
LINE_CHANNEL_ACCESS_TOKEN=xxxxx

# Google Calendar連携
GOOGLE_CLIENT_ID=xxxxx
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_CALENDAR_ID=primary

# レセコン（ORCA）連携
ORCA_API_ENDPOINT=http://localhost:8000
ORCA_API_KEY=xxxxx

# Redis（Upstash）
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx
